<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="220dp"
    android:layout_height="wrap_content"
    android:background="#CC0A0A0A"
    android:padding="12dp">

    <!-- shape arredondado aplicado via background abaixo -->

    <TextView
        android:id="@+id/tv_panel_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PAINEL NEXUS"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="14sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/sw_esp_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ESP Linha"
        android:textColor="#FFFFFF"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tv_panel_title"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/sw_esp_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ESP Box"
        android:textColor="#FFFFFF"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/sw_esp_line"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/sw_esp_skeleton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ESP Skeleton"
        android:textColor="#FFFFFF"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/sw_esp_box"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/sw_esp_distance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ESP Distância"
        android:textColor="#FFFFFF"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/sw_esp_skeleton"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/sw_aimbot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Aimbot (Embolt)"
        android:textColor="#FFFFFF"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/sw_esp_distance"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_fov_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="FOV: 150"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/sw_aimbot"
        app:layout_constraintStart_toStartOf="parent" />

    <SeekBar
        android:id="@+id/seek_fov"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="500"
        android:progress="150"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintTop_toBottomOf="@id/tv_fov_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
